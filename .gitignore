# Ignore generated and sensitive/transient files
.gradle/
.venv/
venv/
__pycache__/
*.pyc
*.pdb
*.user
*.log
*.tmp
*.bak
*.backup

# Android/Java build intermediates
app/build/
build/
manual-build/
artifacts/build-output/manual-build/
artifacts/build-output/probe-build/
